generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model audit_logs {
  audit_id    Int       @id @default(autoincrement())
  user_id     Int?
  user_action String    @db.VarChar(100)
  table_name  String    @db.VarChar(100)
  record_id   Int
  old_value   Json?
  new_value   Json?
  ip_address  String    @db.VarChar(45)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users?    @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)
}

model categories {
  category_id          Int          @id @default(autoincrement())
  category_name        String       @db.VarChar(299)
  slug                 String       @unique @db.VarChar(299)
  category_description String?
  parent_id            Int?
  display_order        Int?         @default(0)
  image_url            String?      @db.VarChar(500)
  is_active            Boolean?     @default(true)
  created_at           DateTime?    @default(now()) @db.Timestamp(6)
  updated_at           DateTime?    @default(now()) @db.Timestamp(6)
  categories           categories?  @relation("categoriesTocategories", fields: [parent_id], references: [category_id], onUpdate: NoAction)
  other_categories     categories[] @relation("categoriesTocategories")
  menu_items           menu_items[]
}

model customers {
  customer_id    Int            @id @default(autoincrement())
  customer_name  String         @db.VarChar(200)
  phone_number   String         @db.VarChar(20)
  user_email     String?        @unique @db.VarChar(200)
  user_address   String?
  loyalty_points Int?           @default(0)
  loyalty_transactions loyalty_transactions[]
  is_active      Boolean?       @default(true)
  created_at     DateTime?      @default(now()) @db.Timestamp(6)
  updated_at     DateTime?      @default(now()) @db.Timestamp(6)
  orders         orders[]
  reservations   reservations[]
   user_password  String?   @db.VarChar(200)
   refresh_token  String? 
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model discounts {
  discount_id      Int       @id @default(autoincrement())
  discount_code    String    @unique @db.VarChar(50)
  discount_name    String    @db.VarChar(200)
  discount_type    String?   @default("fixed") @db.VarChar(20)
  discount_value   Decimal?  @default(0.00) @db.Decimal(10, 2)
  min_order_amount Decimal?  @default(0.00) @db.Decimal(10, 2)
  max_uses         Int?      @default(1)
  used_count       Int?      @default(0)
  valid_from       DateTime? @default(now()) @db.Timestamp(6)
  valid_until      DateTime  @db.Timestamp(6)
  is_active        Boolean?  @default(true)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
}

model ingredients {
  id              String    @id @default(uuid())
  name            String    @db.VarChar(200)
  description     String?
  category        String    @db.VarChar(100)
  unit            String    @db.VarChar(50)
  current_stock   Decimal   @default(0) @db.Decimal(10, 2)
  min_stock       Decimal   @default(0) @db.Decimal(10, 2)
  max_stock       Decimal   @default(100) @db.Decimal(10, 2)
  cost_per_unit   Decimal   @default(0) @db.Decimal(10, 2)
  barcode         String?   @db.VarChar(100)
  image_url       String?   @db.VarChar(500)
  expiration_date DateTime? @db.Timestamp(6)
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @updatedAt @db.Timestamp(6)
  supplier_id     String?
  supplier        suppliers?       @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  stock_movements stock_movements[]
  stock_alerts    stock_alerts[]
  invoice_items   invoice_items[]
}

model suppliers {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(200)
  contact_person String?   @db.VarChar(200)
  email          String?   @db.VarChar(200)
  phone          String?   @db.VarChar(50)
  address        String?
  payment_terms  String?   @db.VarChar(200)
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @updatedAt @db.Timestamp(6)
  ingredients    ingredients[]
  invoices       invoices[]
}

model invoices {
  id             String        @id @default(uuid())
  invoice_number String        @db.VarChar(100)
  supplier_id    String?
  supplier_name  String        @db.VarChar(200)
  invoice_date   DateTime      @db.Timestamp(6)
  total_amount   Decimal       @default(0) @db.Decimal(10, 2)
  image_url      String?       @db.VarChar(500)
  status         String        @default("pending") @db.VarChar(20)
  created_at     DateTime      @default(now()) @db.Timestamp(6)
  updated_at     DateTime      @updatedAt @db.Timestamp(6)
  supplier       suppliers?    @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  items          invoice_items[]
}

model invoice_items {
  id              String      @id @default(uuid())
  invoice_id      String
  ingredient_id   String?
  ingredient_name String      @db.VarChar(200)
  quantity        Decimal     @db.Decimal(10, 2)
  unit            String      @db.VarChar(50)
  unit_price      Decimal     @db.Decimal(10, 2)
  total_price     Decimal     @db.Decimal(10, 2)
  expiration_date DateTime?   @db.Timestamp(6)
  barcode         String?     @db.VarChar(100)
  created_at      DateTime    @default(now()) @db.Timestamp(6)
  invoice         invoices    @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  ingredient      ingredients? @relation(fields: [ingredient_id], references: [id], onDelete: SetNull)
}

model stock_movements {
  id            String      @id @default(uuid())
  ingredient_id String
  movement_type String      @db.VarChar(20)
  quantity      Decimal     @db.Decimal(10, 2)
  unit          String      @db.VarChar(50)
  reason        String      @db.VarChar(300)
  reference_id  String?     @db.VarChar(100)
  created_by    String?     @db.VarChar(100)
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  ingredient    ingredients @relation(fields: [ingredient_id], references: [id], onDelete: Cascade)
}

model stock_alerts {
  id            String      @id @default(uuid())
  ingredient_id String
  alert_type    String      @db.VarChar(30)
  message       String
  is_read       Boolean     @default(false)
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  ingredient    ingredients @relation(fields: [ingredient_id], references: [id], onDelete: Cascade)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model kitchen_display {
  kitchen_display_id Int         @id @default(autoincrement())
  order_id           Int
  order_item_id      Int
  order_status       String?     @default("received") @db.VarChar(20)
  order_priority     String?     @default("in_queue") @db.VarChar(20)
  received_at        DateTime?   @default(now()) @db.Timestamp(6)
  prepared_at        DateTime?   @db.Timestamp(6)
  completed_at       DateTime?   @db.Timestamp(6)
  orders             orders      @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
  order_items        order_items @relation(fields: [order_item_id], references: [order_item_id], onDelete: Cascade, onUpdate: NoAction)
}

model menu_item_modifiers {
  id            Int         @id @default(autoincrement())
  menu_item_id  Int?
  modifier_name String      @db.VarChar(300)
  extra_charge  Decimal?    @default(0.00) @db.Decimal(10, 2)
  is_available  Boolean?    @default(true)
  created_at    DateTime?   @default(now()) @db.Timestamp(6)
  updated_at    DateTime?   @default(now()) @db.Timestamp(6)
  menu_items    menu_items? @relation(fields: [menu_item_id], references: [menu_items_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model menu_items {
  menu_items_id          Int                   @id @default(autoincrement())
  menu_items_category_id Int?
  menu_items_name        String                @db.VarChar(200)
  slug                   String                @unique @db.VarChar(200)
  menu_items_description String?
  price                  Decimal               @db.Decimal(10, 2)
  cost_price             Decimal?              @db.Decimal(10, 2)
  image_url              String?               @db.VarChar(500)
  is_available           Boolean?              @default(true)
  prep_time              Int?
  calories               Int?
  display_order          Int?                  @default(0)
  created_at             DateTime?             @default(now()) @db.Timestamp(6)
  updated_at             DateTime?             @default(now()) @db.Timestamp(6)
  menu_item_modifiers    menu_item_modifiers[]
  categories             categories?           @relation(fields: [menu_items_category_id], references: [category_id], onUpdate: NoAction)
  order_items            order_items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  order_item_id     Int               @id @default(autoincrement())
  order_id          Int
  menu_item_id      Int
  quantity          Int               @default(1)
  unit_price        Decimal           @db.Decimal(10, 2)
  subtotal          Decimal           @db.Decimal(10, 2)
  special_request   String?
  order_item_status String?           @default("pending") @db.VarChar(20)
  created_at        DateTime?         @default(now()) @db.Timestamp(6)
  updated_at        DateTime?         @default(now()) @db.Timestamp(6)
  kitchen_display   kitchen_display[]
  menu_items        menu_items        @relation(fields: [menu_item_id], references: [menu_items_id], onUpdate: NoAction)
  orders            orders            @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  order_id        Int               @id @default(autoincrement())
  table_id        Int?
  user_id         Int?
  customer_id     Int?
  order_type      String            @db.VarChar(20)
  order_status    String?           @default("pending") @db.VarChar(20)
  special_notes   String?
  subtotal        Decimal?          @default(0.00) @db.Decimal(10, 2)
  discount        Decimal?          @default(0.00) @db.Decimal(10, 2)
  tax             Decimal?          @default(0.00) @db.Decimal(10, 2)
  total_amount    Decimal?          @default(0.00) @db.Decimal(10, 2)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  kitchen_display kitchen_display[]
  order_items     order_items[]
  customers       customers?        @relation(fields: [customer_id], references: [customer_id], onUpdate: NoAction)
  tables          tables?           @relation(fields: [table_id], references: [table_id], onUpdate: NoAction)
  users           users?            @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)
  payments        payments[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  payment_id      Int       @id @default(autoincrement())
  order_id        Int
  payment_method  String    @db.VarChar(30)
  amount_paid     Decimal   @db.Decimal(10, 2)
  change_given    Decimal?  @default(0.00) @db.Decimal(10, 2)
  payment_status  String?   @default("pending") @db.VarChar(20)
  transaction_ref String?   @db.VarChar(100)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)
  orders          orders    @relation(fields: [order_id], references: [order_id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reservations {
  reservation_id     Int        @id @default(autoincrement())
  customer_id        Int?
  table_id           Int?
  party_size         Int        @default(1)
  reserved_at        DateTime   @db.Timestamp(6)
  reservation_status String?    @default("pending") @db.VarChar(20)
  reservation_notes  String?
  created_at         DateTime?  @default(now()) @db.Timestamp(6)
  updated_at         DateTime?  @default(now()) @db.Timestamp(6)
  customers          customers? @relation(fields: [customer_id], references: [customer_id], onUpdate: NoAction)
  tables             tables?    @relation(fields: [table_id], references: [table_id], onUpdate: NoAction)
}
model minis {
  mini_id       Int       @id @default(autoincrement())
  user_id       Int       // admin (restaurant owner) who uploaded
  title         String    @db.VarChar(200)
  description   String?
  video_url     String    @db.VarChar(500)   // Cloudinary URL
  thumbnail_url String?   @db.VarChar(500)
  status        String?   @default("pending") @db.VarChar(20) // pending | approved | rejected
  rejection_reason String?
  view_count    Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  users         users     @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)
}

model shifts {
  shift_id      Int       @id @default(autoincrement())
  user_id       Int
  start_time    DateTime  @db.Timestamp(6)
  end_time      DateTime? @db.Timestamp(6)
  break_minutes Int?      @default(0)
  total_hours   Decimal?  @db.Decimal(5, 2)
  notes         String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  users         users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tables {
  table_id     Int            @id @default(autoincrement())
  table_number String         @unique @db.VarChar(20)
  floor        String?        @default("Ground Floor") @db.VarChar(20)
  capacity     Int            @default(1)
  table_status String?        @default("Available") @db.VarChar(20)
  is_active    Boolean?       @default(true)
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  updated_at   DateTime?      @default(now()) @db.Timestamp(6)
  orders       orders[]
  reservations reservations[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id       Int          @id @default(autoincrement())
  user_name     String       @db.VarChar(200)
  user_password String       @db.VarChar(200)
  user_email    String       @unique @db.VarChar(260)
  user_role     String       @db.VarChar(50)
  is_active     Boolean?     @default(true)
  last_login    DateTime?    @db.Timestamp(6)
  refresh_token String?
  created_at    DateTime?    @default(now()) @db.Timestamp(6)
  updated_at    DateTime?    @default(now()) @db.Timestamp(6)
  audit_logs    audit_logs[]
  orders        orders[]
  shifts        shifts[]
  minis minis[] 
}
model loyalty_transactions {
  transaction_id   Int       @id @default(autoincrement())
  customer_id      Int
  order_id         Int?
  points           Int
  transaction_type String    @db.VarChar(20)
  description      String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  customers        customers @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: NoAction)
}
